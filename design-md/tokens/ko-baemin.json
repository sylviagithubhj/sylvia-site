ght":700,"lh":1.18,"family":"","role":"섹션 제목"},{"name":"titleLarge","size":22.0,"weight":700,"lh":1.08,"family":"","role":"카드·시트 제목"},{"name":"subheadingMedium","size":20.0,"weight":700,"lh":1.2,"family":"","role":"섹션 제목"},{"name":"titleMedium","size":20.0,"weight":700,"lh":1.08,"family":"","role":"카드 제목"},{"name":"subheadingSmall","size":18.0,"weight":700,"lh":1.22,"family":"","role":"섹션 제목"},{"name":"titleSmall","size":18.0,"weight":700,"lh":1.08,"family":"","role":"리스트 제목"},{"name":"bodyLarge","size":16.0,"weight":400,"lh":1.5,"family":"","role":"본문 큰"},{"name":"labelLarge","size":16.0,"weight":400,"lh":1.08,"family":"","role":"큰 버튼 글자(Emphasized 700)"},{"name":"bodyMedium","size":14.0,"weight":400,"lh":1.5,"family":"","role":"기본 본문"},{"name":"labelMedium","size":14.0,"weight":400,"lh":1.09,"family":"","role":"중간 버튼 글자(Emphasized 700)"},{"name":"bodySmall","size":12.0,"weight":400,"lh":1.5,"family":"","role":"작은 본문"},{"name":"labelSmall","size":12.0,"weight":400,"lh":1.08,"family":"","role":"작은 버튼·칩 글자(Emphasized 700)"},{"name":"captionLarge","size":12.0,"weight":400,"lh":1.08,"family":"","role":"보조 설명"},{"name":"captionMedium","size":11.0,"weight":400,"lh":1.08,"family":"","role":"보조 설명"},{"name":"footnote","size":11.0,"weight":400,"lh":1.36,"family":"","role":"각주"},{"name":"captionSmall","size":10.0,"weight":400,"lh":1.08,"family":"","role":"가장 작은 글자"},{"name":"detail","size":10.0,"weight":400,"lh":1.3,"family":"","role":"세부 정보"}],"radius":[{"name":"none","value":"0px"},{"name":"xsmall","value":"2px"},{"name":"small","value":"4px"},{"name":"medium","value":"8px"},{"name":"large","value":"12px"},{"name":"xlarge","value":"16px"},{"name":"xxlarge","value":"20px"},{"name":"rounded","value":"9999px"}],"spacing":[{"name":"spacing-25","value":"2px"},{"name":"spacing-50","value":"4px"},{"name":"spacing-75","value":"6px"},{"name":"spacing-100","value":"8px"},{"name":"spacing-125","value":"10px"},{"name":"spacing-150","value":"12px"},{"name":"spacing-200","value":"16px"},{"name":"spacing-250","value":"20px"},{"name":"spacing-300","value":"24px"},{"name":"spacing-400","value":"32px"},{"name":"spacing-500","value":"40px"},{"name":"spacing-600","value":"48px"},{"name":"spacing-800","value":"64px"},{"name":"spacing-1000","value":"80px"}],"strengths":[{"title":"토큰이 3층으로 나뉜다","why":"baemin.com 한 페이지에 CSS 변수 1,746개가 --ref-color-(원색) → --sem-mint-color-(의미) → --com-mint-(컴포넌트)로 실려 있고, 컴포넌트 토큰만 테마당 600개 안팎이다."},{"title":"글자 크기 설정이 토큰에 들어 있다","why":"7단계 크기 설정 클래스에 따라 bodyMedium이 12·13·14·15·17·19·20px로 바뀐다. 실측 시 body에는 4번째 단계가 붙어 있었다."},{"title":"글자·테두리 단계를 투명도로 만든다","why":"foregroundSecondary .78, Tertiary .56, Quaternary .33, Disabled .18, borderTertiary .11, separator .06처럼 #181a1c 한 색의 투명도만 바꾼다. base 테마는 같은 이름에 더 옅은 값(예: .56, 딤 .3)을 쓴다."},{"title":"민트에 검정 글자를 올린다","why":"주 버튼은 #0cefd3 채움에 #000000 글자(대비 14.3:1)라, 밝은 브랜드색인데도 글자가 잘 읽힌다."},{"title":"회사가 글꼴을 직접 만들어 배포한다","why":"한나체(2012)부터 꾸불림체(2024)까지 공식 글꼴 12종을 무료로 내놓고, 안내 페이지 72px 큰 문구는 BAEMINWORK 웹폰트로 그린다."}],"learn":["밝은 브랜드색을 버튼에 쓸 때 배달의민족처럼 흰 글자 대신 검정 글자를 올려 대비를 확보한다.","글자 색 단계를 만들 때 배달의민족처럼 본문색 하나에 투명도(.78/.56/.33/.18)만 바꿔 쓰면 바탕이 바뀌어도 단계가 유지된다.","글자 크기 설정을 지원할 때 배달의민족처럼 화면 값을 바꾸지 말고 토큰 크기표를 단계별로(예: 12~20px) 만들어 바꿔 끼운다."]}